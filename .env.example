# MySQL — agent-owned DB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=intactix_agent_db
MYSQL_USER=intactix_agent
MYSQL_PASSWORD=

# Xero OAuth
# Phase 0-2 scopes (read-only):
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3010/callback
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=
XERO_AUTH_SCOPES=offline_access accounting.settings.read accounting.contacts.read accounting.invoices.read accounting.payments.read accounting.banktransactions.read accounting.manualjournals.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read accounting.reports.trialbalance.read accounting.contacts accounting.invoices accounting.attachments
# Bank feed evidence mode:
#   accounting_api       = default; no gated Finance API dependency. Uses Accounting API
#                          bank transactions/payments/transfers/reports plus direct Wise/Revolut feeds.
#   bank_statements_plus = optional; attempts raw Xero statement-line sync via gated Finance API.
BANK_FEED_SOURCE=accounting_api
# Phase 3 write scopes (add to XERO_AUTH_SCOPES and re-run OAuth consent flow):
#   accounting.transactions accounting.contacts accounting.attachments
# Phase 4 inbox polling scope (add to XERO_AUTH_SCOPES and re-run OAuth consent flow):
#   files.read
# Bank statement lines:
# Xero Finance API / Bank Statements Plus is restricted for this app. Do not
# depend on finance.bankstatementsplus.read; use Accounting API fallback plus
# direct Wise/Revolut provider feeds for raw card/bank activity.
# Enable write operations (set to true after re-authorizing with write scopes):
XERO_WRITE_ENABLED=false

# PrestaShop BI database (local read-only replica)
PS_BI_HOST=127.0.0.1
PS_BI_PORT=3306
PS_BI_DATABASE=gopure_bi
PS_BI_USER=gp_bi_user
PS_BI_PASSWORD=
PS_TABLE_PREFIX=pscw_

# PrestaShop invoice PDF endpoint (preferred for PDF attach)
# Install prestashop-modules/intactixpdf on the shop and configure the same HMAC secret there.
PS_PDF_ENDPOINT_URL=/module/gp_xeropdf/invoice
PS_PDF_HMAC_SECRET=

# PrestaShop webservice REST API (metadata fallback only; standard order_invoices does not return PDF bytes)
# Create a key at: Admin > Advanced Parameters > Webservice > Add
# Required permissions: order_invoices (GET)
PS_WEBSERVICE_KEY=
PS_WEBSERVICE_BASE_URL=https://gopure.shop
PS_WEBSERVICE_STAGING_URL=https://staging.gopure.shop

# Wise Business API (card activity sync — fallback for unreconciled card spend)
# Create a read-only API token: Wise Business → Settings → API tokens
WISE_API_TOKEN=
WISE_PROFILE_ID=   # Business profile ID — leave blank to use default 36756352

# Revolut Business API — agent calls broker on gopure.store (IP-whitelisted)
# Broker handles OAuth token rotation; agent authenticates to broker via HMAC.
# Value: contents of ~/private_html/internal_hmac.key on gopure.store
REVOLUT_BROKER_HMAC=

# Supplier invoice mailbox (MXRoute) — primary Bills Management entry point.
# IMAP only; SMTP is intentionally not configured (agent never sends mail from this box).
MAILBOX_IMAP_HOST=sunfire.mxrouting.net
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true
MAILBOX_IMAP_USER=xero@intactix.io
MAILBOX_IMAP_PASSWORD=

# Tuning
XERO_PAGE_SIZE=100
XERO_RATE_LIMIT_RETRY_MS=65000
DEFAULT_SYNC_LOOKBACK_DAYS=90
